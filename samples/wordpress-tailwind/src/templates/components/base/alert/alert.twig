{#
  Params:
  - variant?: 'default'|'destructive' as string (default: 'default')
  - icon?: String — sprite icon name rendered before the title/description grid
  - title?: String — rendered in alert-title
  - description?: String — rendered in alert-description (plain text; use block
                   description for rich content with multiple paragraphs)
  - id?: String
  - class?: String — appended last on the alert root; additive utilities only
  - attrs?: String — raw extra attributes on the alert root, trusted input only
  - blocks: description — overrides the default description paragraph; the
            wrapper div lives inside the block, so an override must include
            the upstream wrapper with its data-slot and classes:
    description: <div data-slot="alert-description" class="col-start-2 grid justify-items-start gap-1 text-sm text-muted-foreground [&_p]:leading-relaxed">...</div>
#}
{% set variant = variant|default('default') %}
{% set alert_variants = {
  default: "bg-card text-card-foreground",
  destructive: "bg-card text-destructive *:data-[slot=alert-description]:text-destructive/90 [&>svg]:text-current"
} %}
{% set alert_classes = "relative grid w-full grid-cols-[0_1fr] items-start gap-y-0.5 rounded-lg border px-4 py-3 text-sm has-[>svg]:grid-cols-[calc(var(--spacing)*4)_1fr] has-[>svg]:gap-x-3 [&>svg]:size-4 [&>svg]:translate-y-0.5 [&>svg]:text-current " ~ alert_variants[variant] ~ (class is defined and class ? ' ' ~ class : '') %}
<div
  data-slot="alert"
  data-variant="{{ variant }}"
  role="alert"
  class="{{ alert_classes }}"
  {%- if id is defined and id %} id="{{ id }}"{% endif %} {{ attrs|default('')|raw }}>
  {%- if icon %}<svg aria-hidden="true"><use href="#icon-{{ icon }}"></use></svg>{% endif %}
  {%- if title %}<div data-slot="alert-title" class="col-start-2 line-clamp-1 min-h-4 font-medium tracking-tight">{{ title }}</div>{% endif %}
  {% block description %}
    {% if description %}<div data-slot="alert-description" class="col-start-2 grid justify-items-start gap-1 text-sm text-muted-foreground [&_p]:leading-relaxed"><p>{{ description }}</p></div>{% endif %}
  {% endblock %}
</div>
