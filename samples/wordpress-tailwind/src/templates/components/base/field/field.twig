{#
  Field — form field layout wrapper (upstream field.tsx: FieldSet, FieldLegend, FieldGroup,
  Field, FieldContent, FieldLabel, FieldTitle, FieldDescription, FieldSeparator, FieldError).

  Params (default export — a single Field):
  - label?: String — FieldLabel text
  - for?: String — id of the control this label is bound to (required when `label` is set)
  - description?: String — FieldDescription text
  - error?: String — FieldError text, shown when `invalid` is true
  - errors?: Array<{ message?: String }> — alternative to `error`: deduped, rendered as a list
              when more than one unique message remains (matches upstream FieldError)
  - orientation?: 'vertical'|'horizontal'|'responsive' as string (default: 'vertical')
  - invalid?: Boolean — sets data-invalid="true"/aria-invalid semantics and text-destructive
  - disabled?: Boolean — sets data-disabled="true"
  - id?: String
  - class?: String — appended last on the field root; additive utilities only
  - attrs?: String — raw extra attributes on the field root, trusted input only
  - {% block control %} — the form control; renders nothing by default (caller overrides this
              block via {% embed %}, e.g. with base/input or base/native-select)

  Composition macros (import from this file — `{% import '@components/base/field/field.twig' as
  field %}` — to build multi-field forms; see src/docs/forms.twig):
    field.fieldSet(legend, content, opts)      <fieldset data-slot="field-set">
    field.fieldLegend(text, variant)           <legend data-slot="field-legend">
    field.fieldGroup(content)                  <div data-slot="field-group">
    field.fieldContent(content)                <div data-slot="field-content">
    field.fieldTitle(text)                     <div data-slot="field-label"> (FieldTitle's own
                                                data-slot upstream, verified against field.tsx)
    field.fieldSeparator(text)                 <div data-slot="field-separator">
    field.fieldError(message|messages)         <div data-slot="field-error">

  Note: FieldLabel is NOT rendered via base/label/label.twig's include — label.twig hardcodes
  data-slot="label" with no slot-override param (same limitation noted in
  docs/reports/phase-4-b2a-static.md, follow-up B8, for button.twig/separator.twig), and upstream
  relies on `[data-slot=field-label]` selectors (peer/group scoping) landing on the <label>
  itself. FieldLabel is rendered inline here instead, reusing label.twig's own base string
  verbatim plus the field-label overrides.

  Figma override (scripts/upstream-exceptions.json "field"): FieldSet's own gap is 12px (gap-3),
  not upstream's gap-6 (24px). Field's own gap already matches the kit's "field gap 12" fact
  (fieldVariants base is already gap-3 upstream) and FieldLabel/FieldTitle text already matches
  the kit's "label 14/20" fact (text-sm + leading-snug) — neither needed an override.
#}

{% macro fieldSet(legend, content, opts) %}
  {%- set opts = opts|default({}) %}
  <fieldset data-slot="field-set" class="flex flex-col gap-3 has-[>[data-slot=checkbox-group]]:gap-3 has-[>[data-slot=radio-group]]:gap-3{% if opts.class %} {{ opts.class }}{% endif %}"{% if opts.id %} id="{{ opts.id }}"{% endif %} {{ opts.attrs|default('')|raw }}>
    {%- if legend %}<legend data-slot="field-legend" data-variant="{{ opts.legendVariant|default('legend') }}" class="mb-3 font-medium data-[variant=legend]:text-base data-[variant=label]:text-sm">{{ legend }}</legend>{% endif %}
    {{- content|raw }}
  </fieldset>
{% endmacro %}

{% macro fieldLegend(text, variant) %}
  <legend data-slot="field-legend" data-variant="{{ variant|default('legend') }}" class="mb-3 font-medium data-[variant=legend]:text-base data-[variant=label]:text-sm">{{ text }}</legend>
{% endmacro %}

{% macro fieldGroup(content, opts) %}
  {%- set opts = opts|default({}) %}
  <div data-slot="field-group" class="group/field-group @container/field-group flex w-full flex-col gap-7 data-[slot=checkbox-group]:gap-3 [&>[data-slot=field-group]]:gap-4{% if opts.class %} {{ opts.class }}{% endif %}"{% if opts.id %} id="{{ opts.id }}"{% endif %} {{ opts.attrs|default('')|raw }}>
    {{- content|raw }}
  </div>
{% endmacro %}

{% macro fieldContent(content, opts) %}
  {%- set opts = opts|default({}) %}
  <div data-slot="field-content" class="group/field-content flex flex-1 flex-col gap-1.5 leading-snug{% if opts.class %} {{ opts.class }}{% endif %}"{% if opts.id %} id="{{ opts.id }}"{% endif %} {{ opts.attrs|default('')|raw }}>
    {{- content|raw }}
  </div>
{% endmacro %}

{% macro fieldTitle(text) %}
  <div data-slot="field-label" class="flex w-fit items-center gap-2 text-sm leading-snug font-medium group-data-[disabled=true]/field:opacity-50">{{ text }}</div>
{% endmacro %}

{% macro fieldSeparator(text) %}
  <div data-slot="field-separator" data-content="{{ text ? 'true' : 'false' }}" class="relative -my-2 h-5 text-sm group-data-[variant=outline]/field-group:-mb-2">
    <div data-slot="separator" data-orientation="horizontal" role="none" class="shrink-0 bg-border absolute inset-0 top-1/2 h-px w-full"></div>
    {%- if text %}<span data-slot="field-separator-content" class="relative mx-auto block w-fit bg-background px-2 text-muted-foreground">{{ text }}</span>{% endif %}
  </div>
{% endmacro %}

{% macro fieldError(message, messages) %}
  {%- if messages and messages|length > 1 %}
  <div role="alert" data-slot="field-error" class="text-sm font-normal text-destructive">
    <ul class="ml-4 flex list-disc flex-col gap-1">
      {%- for m in messages %}<li>{{ m }}</li>{% endfor %}
    </ul>
  </div>
  {%- elseif messages and messages|length == 1 %}
  <div role="alert" data-slot="field-error" class="text-sm font-normal text-destructive">{{ messages[0] }}</div>
  {%- elseif message %}
  <div role="alert" data-slot="field-error" class="text-sm font-normal text-destructive">{{ message }}</div>
  {%- endif %}
{% endmacro %}

{% set field_orientations = {
  vertical: "flex-col [&>*]:w-full [&>.sr-only]:w-auto",
  horizontal: "flex-row items-center [&>[data-slot=field-label]]:flex-auto has-[>[data-slot=field-content]]:items-start has-[>[data-slot=field-content]]:[&>[role=checkbox],[role=radio]]:mt-px",
  responsive: "flex-col @md/field-group:flex-row @md/field-group:items-center [&>*]:w-full @md/field-group:[&>*]:w-auto [&>.sr-only]:w-auto @md/field-group:[&>[data-slot=field-label]]:flex-auto @md/field-group:has-[>[data-slot=field-content]]:items-start @md/field-group:has-[>[data-slot=field-content]]:[&>[role=checkbox],[role=radio]]:mt-px"
} %}
{% set orientation = orientation|default('vertical') %}
{% set field_classes = "group/field flex w-full gap-3 data-[invalid=true]:text-destructive " ~ field_orientations[orientation] ~ (class is defined and class ? ' ' ~ class : '') %}
{% set errors = errors|default([]) %}
{% set unique_error_messages = [] %}
{% for e in errors %}{% if e.message and e.message not in unique_error_messages %}{% set unique_error_messages = unique_error_messages|merge([e.message]) %}{% endif %}{% endfor %}

<div
  role="group"
  data-slot="field"
  data-orientation="{{ orientation }}"
  {%- if invalid %} data-invalid="true"{% endif %}
  {%- if disabled %} data-disabled="true"{% endif %}
  class="{{ field_classes }}"
  {%- if id is defined and id %} id="{{ id }}"{% endif %} {{ attrs|default('')|raw }}>

  {%- if label %}
  <label data-slot="field-label" {%- if for %} for="{{ for }}"{% endif %} class="flex items-center gap-2 text-sm leading-none font-medium select-none peer-disabled:cursor-not-allowed peer-disabled:opacity-50 group/field-label peer/field-label w-fit leading-snug group-data-[disabled=true]/field:opacity-50 has-[>[data-slot=field]]:w-full has-[>[data-slot=field]]:flex-col has-[>[data-slot=field]]:rounded-md has-[>[data-slot=field]]:border [&>*]:data-[slot=field]:p-4 has-data-[state=checked]:border-primary has-data-[state=checked]:bg-primary/5 dark:has-data-[state=checked]:bg-primary/10">{{ label }}</label>
  {%- endif %}

  {% block control %}{% endblock %}

  {%- if description %}
  <p data-slot="field-description" class="text-sm leading-normal font-normal text-muted-foreground group-has-[[data-orientation=horizontal]]/field:text-balance last:mt-0 nth-last-2:-mt-1 [[data-variant=legend]+&]:-mt-1.5 [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary">{{ description }}</p>
  {%- endif %}

  {%- if invalid and (error or unique_error_messages|length) %}
    {%- if unique_error_messages|length > 1 %}
    <div role="alert" data-slot="field-error" class="text-sm font-normal text-destructive">
      <ul class="ml-4 flex list-disc flex-col gap-1">
        {%- for m in unique_error_messages %}<li>{{ m }}</li>{% endfor %}
      </ul>
    </div>
    {%- elseif unique_error_messages|length == 1 %}
    <div role="alert" data-slot="field-error" class="text-sm font-normal text-destructive">{{ unique_error_messages[0] }}</div>
    {%- else %}
    <div role="alert" data-slot="field-error" class="text-sm font-normal text-destructive">{{ error }}</div>
    {%- endif %}
  {%- endif %}
</div>
