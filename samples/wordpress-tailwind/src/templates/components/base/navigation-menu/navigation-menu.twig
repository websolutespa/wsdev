{#
  Params:
  - items: Array<{
      label: String — trigger / link text,
      url?: String — plain link when the entry has no items[],
      active?: Boolean — marks the current page (data-active="true"),
      items?: Array<{ title: String, url: String, description?: String, icon?: String }>
              — rich panel content; presence of this array turns the entry into a trigger
    }>
  - viewport?: Boolean — true renders the shared morphing viewport all panels are moved into;
                         false leaves every panel under its own item (default: true)
  - indicator?: Boolean — renders navigation-menu-indicator, the arrow tracking the open
                          trigger (default: false)
  - ariaLabel?: String — aria-label on the <nav> (default: 'Navigazione principale')
  - id?: String — id on the component root
  - class?: String — extra classes on the nav root; additive only
  - attrs?: String — raw extra attributes on the nav root, trusted input only

  JS module (data-module="navigation-menu.module"):
    consumes  CustomEvent 'navigation-menu:open' (detail.index: Number, default 0),
              'navigation-menu:close'
    emits     CustomEvent 'navigation-menu:opened' ({ index }), 'navigation-menu:closed'
              ({ index }) — bubbling from the nav root
    hooks     data-viewport on the root selects viewport vs per-item panels

  Adaptation: `--radix-navigation-menu-viewport-width` / `-height` → `--viewport-width` /
  `--viewport-height` (PORTING.md Adaptation table). In viewport mode common/floating.js is not
  involved — the module measures the active panel and writes the two variables on the viewport
  itself, which is what Radix's own measurement does.
#}

{% set navigation_menu_trigger_style = "group inline-flex h-9 w-max items-center justify-center rounded-md bg-background px-4 py-2 text-sm font-medium transition-[color,box-shadow] outline-none hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-1 disabled:pointer-events-none disabled:opacity-50 data-[state=open]:bg-accent/50 data-[state=open]:text-accent-foreground data-[state=open]:hover:bg-accent data-[state=open]:focus:bg-accent" %}
{% set navigation_menu_link_style = "flex flex-col gap-1 rounded-sm p-2 text-sm transition-all outline-none hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-1 data-[active=true]:bg-accent/50 data-[active=true]:text-accent-foreground data-[active=true]:hover:bg-accent data-[active=true]:focus:bg-accent [&_svg:not([class*='size-'])]:size-4 [&_svg:not([class*='text-'])]:text-muted-foreground" %}
{% set use_viewport = viewport is not defined or viewport %}

<nav data-slot="navigation-menu" data-module="navigation-menu.module"
  data-viewport="{{ use_viewport ? 'true' : 'false' }}"
  aria-label="{{ ariaLabel|default('Navigazione principale') }}"
  {%- if id is defined and id %} id="{{ id }}"{% endif %}
  class="group/navigation-menu relative flex max-w-max flex-1 items-center justify-center{% if class is defined and class %} {{ class }}{% endif %}"
  {{ attrs|default('')|raw }}>

  <ul data-slot="navigation-menu-list" class="group flex flex-1 list-none items-center justify-center gap-1">
    {% for item in items|default([]) %}
      <li data-slot="navigation-menu-item" class="relative">
        {% if item.items is defined and item.items %}
          <button type="button" data-slot="navigation-menu-trigger" aria-expanded="false" data-state="closed"
            class="{{ navigation_menu_trigger_style }} group">
            {{ item.label }}
            <svg aria-hidden="true" class="relative top-[1px] ml-1 size-3 transition duration-300 group-data-[state=open]:rotate-180"><use href="#icon-chevron-down"></use></svg>
          </button>
          <div data-slot="navigation-menu-content" data-state="closed" hidden
            class="top-0 left-0 w-full p-2 pr-2.5 data-[motion=from-end]:slide-in-from-right-52 data-[motion=from-start]:slide-in-from-left-52 data-[motion=to-end]:slide-out-to-right-52 data-[motion=to-start]:slide-out-to-left-52 data-[motion^=from-]:animate-in data-[motion^=from-]:fade-in data-[motion^=to-]:animate-out data-[motion^=to-]:fade-out md:absolute md:w-auto group-data-[viewport=false]/navigation-menu:top-full group-data-[viewport=false]/navigation-menu:mt-1.5 group-data-[viewport=false]/navigation-menu:overflow-hidden group-data-[viewport=false]/navigation-menu:rounded-md group-data-[viewport=false]/navigation-menu:border group-data-[viewport=false]/navigation-menu:bg-popover group-data-[viewport=false]/navigation-menu:text-popover-foreground group-data-[viewport=false]/navigation-menu:shadow group-data-[viewport=false]/navigation-menu:duration-200 **:data-[slot=navigation-menu-link]:focus:ring-0 **:data-[slot=navigation-menu-link]:focus:outline-none group-data-[viewport=false]/navigation-menu:data-[state=closed]:animate-out group-data-[viewport=false]/navigation-menu:data-[state=closed]:fade-out-0 group-data-[viewport=false]/navigation-menu:data-[state=closed]:zoom-out-95 group-data-[viewport=false]/navigation-menu:data-[state=open]:animate-in group-data-[viewport=false]/navigation-menu:data-[state=open]:fade-in-0 group-data-[viewport=false]/navigation-menu:data-[state=open]:zoom-in-95">
            <ul class="grid gap-2 md:w-[420px] lg:w-[520px] lg:grid-cols-2">
              {% for link in item.items %}
                <li>
                  <a data-slot="navigation-menu-link" href="{{ link.url }}"
                    {%- if link.active|default(false) %} data-active="true"{% endif %}
                    class="{{ navigation_menu_link_style }}">
                    {%- if link.icon|default('') %}<svg aria-hidden="true"><use href="#icon-{{ link.icon }}"></use></svg>{% endif %}
                    <div class="font-medium leading-none">{{ link.title }}</div>
                    {%- if link.description|default('') %}<p class="line-clamp-2 leading-snug text-muted-foreground">{{ link.description }}</p>{% endif %}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% else %}
          <a data-slot="navigation-menu-link" href="{{ item.url|default('#') }}"
            {%- if item.active|default(false) %} data-active="true"{% endif %}
            class="{{ navigation_menu_trigger_style }}">{{ item.label }}</a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>

  {% if indicator|default(false) %}
    <div data-slot="navigation-menu-indicator" data-state="hidden" hidden
      class="top-full z-[1] flex h-1.5 items-end justify-center overflow-hidden data-[state=hidden]:animate-out data-[state=hidden]:fade-out data-[state=visible]:animate-in data-[state=visible]:fade-in">
      <div class="relative top-[60%] h-2 w-2 rotate-45 rounded-tl-sm bg-border shadow-md"></div>
    </div>
  {% endif %}

  {% if use_viewport %}
    <div class="absolute top-full left-0 isolate z-50 flex justify-center">
      <div data-slot="navigation-menu-viewport" data-state="closed" hidden
        class="origin-top-center relative mt-1.5 h-[var(--viewport-height)] w-full overflow-hidden rounded-md border bg-popover text-popover-foreground shadow data-[state=closed]:animate-out data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:zoom-in-90 md:w-[var(--viewport-width)]"></div>
    </div>
  {% endif %}
</nav>
