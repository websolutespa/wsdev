{#
  Params:
  - menus: Array<{ label: String, items: Array<MenuEntry> }> — one entry per top-level menu.
      MenuEntry:
        kind?: 'item'|'checkbox'|'radio'|'separator'|'label'|'group'|'sub' as string (default: 'item')
        label?: String — visible text (unused by 'separator')
        icon?: String — sprite icon name rendered before the label
        shortcut?: String — keyboard hint, right-aligned (item/checkbox/radio/sub)
        url?: String — item only: renders <a>; the module navigates via window.location.assign
        download?: Boolean — item + url only: keeps the native click so the file downloads
        variant?: 'default'|'destructive' as string (default: 'default') — item only
        inset?: Boolean — extra left padding, aligns with the indicator column (item/label/sub)
        disabled?: Boolean
        checked?: Boolean — checkbox/radio only (default: false)
        value?: String — echoed in the 'menu:select' detail
        radio?: Boolean — group only: renders data-slot="menubar-radio-group"
        items?: Array<MenuEntry> — 'group' and 'sub' only; groups are flat (no group inside a group)
  - ariaLabel?: String — aria-label on the menubar (default: 'Barra dei menu')
  - id?: String — id on the menubar root
  - class?: String — extra classes on the menubar root; additive only
  - attrs?: String — raw extra attributes on the menubar root, trusted input only

  JS module (data-module="menubar.module"):
    consumes  CustomEvent 'menu:open' (detail.index: Number, default 0), 'menu:close'
    emits     CustomEvent 'menu:select' { label, value, checked?, index }, 'menu:opened'
              ({ index }), 'menu:closed' ({ index }) — all bubbling from the menubar root

  Adaptation: `--radix-menubar-content-transform-origin` → `--transform-origin`, written by
  common/floating.js (PORTING.md Adaptation table). Radix Portal / Sub wrappers have no host
  here: menubar-portal and menubar-sub are not emitted; menubar-menu is kept as a display:contents
  wrapper so the module can pair each trigger with its panel, and a sub-content panel is a DOM
  sibling of its sub-trigger so the module can find it with nextElementSibling.
#}

{% macro menuEntries(entries) %}
  {% import _self as menu %}
  {% for entry in entries %}
    {% set kind = entry.kind|default('item') %}
    {% if kind == 'separator' %}
      <div role="separator" aria-orientation="horizontal" data-slot="menubar-separator" class="-mx-1 my-1 h-px bg-border"></div>
    {% elseif kind == 'label' %}
      <div data-slot="menubar-label"
        {%- if entry.inset|default(false) %} data-inset="true"{% endif %}
        class="px-3 py-2 text-xs font-medium data-[inset]:pl-8">{{ entry.label }}</div>
    {% elseif kind == 'group' %}
      <div role="group"{% if entry.radio|default(false) %} data-slot="menubar-radio-group"{% else %} data-slot="menubar-group"{% endif %}>
        {% if entry.label|default('') %}
          <div data-slot="menubar-label"
            {%- if entry.inset|default(false) %} data-inset="true"{% endif %}
            class="px-3 py-2 text-xs font-medium data-[inset]:pl-8">{{ entry.label }}</div>
        {% endif %}
        {{ menu.menuEntries(entry.items|default([])) }}
      </div>
    {% elseif kind == 'checkbox' %}
      <div role="menuitemcheckbox" tabindex="-1" aria-checked="{{ entry.checked|default(false) ? 'true' : 'false' }}"
        data-slot="menubar-checkbox-item" data-state="{{ entry.checked|default(false) ? 'checked' : 'unchecked' }}"
        {%- if entry.disabled|default(false) %} data-disabled aria-disabled="true"{% endif %}
        {%- if entry.value is defined %} data-value="{{ entry.value }}"{% endif %}
        class="relative flex cursor-default items-center gap-2 rounded-2xl py-2 pr-2 pl-8 text-sm outline-hidden select-none focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4">
        <span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center">
          <svg class="size-4{% if not entry.checked|default(false) %} hidden{% endif %}" aria-hidden="true"><use href="#icon-check"></use></svg>
        </span>
        {%- if entry.icon|default('') %}<svg aria-hidden="true"><use href="#icon-{{ entry.icon }}"></use></svg>{% endif %}
        <span>{{ entry.label }}</span>
        {%- if entry.shortcut|default('') %}<span data-slot="menubar-shortcut" class="ml-auto text-xs tracking-widest text-muted-foreground">{{ entry.shortcut }}</span>{% endif %}
      </div>
    {% elseif kind == 'radio' %}
      <div role="menuitemradio" tabindex="-1" aria-checked="{{ entry.checked|default(false) ? 'true' : 'false' }}"
        data-slot="menubar-radio-item" data-state="{{ entry.checked|default(false) ? 'checked' : 'unchecked' }}"
        {%- if entry.disabled|default(false) %} data-disabled aria-disabled="true"{% endif %}
        {%- if entry.value is defined %} data-value="{{ entry.value }}"{% endif %}
        class="relative flex cursor-default items-center gap-2 rounded-2xl py-2 pr-2 pl-8 text-sm outline-hidden select-none focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4">
        <span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center">
          <svg class="size-2 fill-current{% if not entry.checked|default(false) %} hidden{% endif %}" aria-hidden="true"><use href="#icon-circle"></use></svg>
        </span>
        {%- if entry.icon|default('') %}<svg aria-hidden="true"><use href="#icon-{{ entry.icon }}"></use></svg>{% endif %}
        <span>{{ entry.label }}</span>
        {%- if entry.shortcut|default('') %}<span data-slot="menubar-shortcut" class="ml-auto text-xs tracking-widest text-muted-foreground">{{ entry.shortcut }}</span>{% endif %}
      </div>
    {% elseif kind == 'sub' %}
      <div role="menuitem" tabindex="-1" aria-haspopup="menu" aria-expanded="false"
        data-slot="menubar-sub-trigger" data-state="closed"
        {%- if entry.inset|default(false) %} data-inset="true"{% endif %}
        {%- if entry.disabled|default(false) %} data-disabled aria-disabled="true"{% endif %}
        {%- if entry.value is defined %} data-value="{{ entry.value }}"{% endif %}
        class="flex cursor-default items-center rounded-2xl px-3 py-2 text-sm outline-none select-none focus:bg-accent focus:text-accent-foreground data-[inset]:pl-8 data-[state=open]:bg-accent data-[state=open]:text-accent-foreground">
        {%- if entry.icon|default('') %}<svg aria-hidden="true"><use href="#icon-{{ entry.icon }}"></use></svg>{% endif %}
        <span>{{ entry.label }}</span>
        <svg class="ml-auto h-4 w-4" aria-hidden="true"><use href="#icon-chevron-right"></use></svg>
      </div>
      <div role="menu" aria-orientation="vertical" tabindex="-1" hidden data-state="closed"
        data-slot="menubar-sub-content"
        class="z-50 min-w-[8rem] origin-(--transform-origin) overflow-hidden rounded-3xl border bg-popover p-1 text-popover-foreground shadow-lg data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95">
        {{ menu.menuEntries(entry.items|default([])) }}
      </div>
    {% else %}
      {% set item_tag = entry.url|default('') ? 'a' : 'div' %}
      <{{ item_tag }}{% if entry.url|default('') %} href="{{ entry.url }}"{% if entry.download|default(false) %} download{% endif %}{% endif %} role="menuitem" tabindex="-1"
        data-slot="menubar-item" data-variant="{{ entry.variant|default('default') }}"
        {%- if entry.inset|default(false) %} data-inset="true"{% endif %}
        {%- if entry.disabled|default(false) %} data-disabled aria-disabled="true"{% endif %}
        {%- if entry.value is defined %} data-value="{{ entry.value }}"{% endif %}
        class="relative flex cursor-default items-center gap-2 rounded-2xl px-3 py-2 text-sm outline-hidden select-none focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50 data-[inset]:pl-8 data-[variant=destructive]:text-destructive data-[variant=destructive]:focus:bg-destructive/10 data-[variant=destructive]:focus:text-destructive dark:data-[variant=destructive]:focus:bg-destructive/20 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 [&_svg:not([class*='text-'])]:text-muted-foreground data-[variant=destructive]:*:[svg]:text-destructive!">
        {%- if entry.icon|default('') %}<svg aria-hidden="true"><use href="#icon-{{ entry.icon }}"></use></svg>{% endif %}
        <span>{{ entry.label }}</span>
        {%- if entry.shortcut|default('') %}<span data-slot="menubar-shortcut" class="ml-auto text-xs tracking-widest text-muted-foreground">{{ entry.shortcut }}</span>{% endif %}
      </{{ item_tag }}>
    {% endif %}
  {% endfor %}
{% endmacro %}

{% import _self as menu %}

<div data-slot="menubar" data-module="menubar.module" role="menubar" aria-orientation="horizontal"
  aria-label="{{ ariaLabel|default('Barra dei menu') }}"
  {%- if id is defined and id %} id="{{ id }}"{% endif %}
  class="flex h-9 items-center gap-1 rounded-md border bg-background p-1 shadow-xs{% if class is defined and class %} {{ class }}{% endif %}"
  {{ attrs|default('')|raw }}>
  {% for entry in menus|default([]) %}
    <div data-slot="menubar-menu" class="contents">
      <button type="button" data-slot="menubar-trigger" role="menuitem" aria-haspopup="menu"
        aria-expanded="false" data-state="closed" tabindex="{{ loop.first ? '0' : '-1' }}"
        class="flex items-center rounded-sm px-2 py-1 text-sm font-medium outline-hidden select-none focus:bg-accent focus:text-accent-foreground data-[state=open]:bg-accent data-[state=open]:text-accent-foreground">{{ entry.label }}</button>
      <div role="menu" aria-orientation="vertical" tabindex="-1" hidden data-state="closed"
        data-slot="menubar-content"
        class="z-50 min-w-[12rem] origin-(--transform-origin) overflow-hidden rounded-3xl border bg-popover p-1 text-popover-foreground shadow-lg data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95">
        {{ menu.menuEntries(entry.items|default([])) }}
      </div>
    </div>
  {% endfor %}
</div>
