{#
  Params:
  - slides?: Array<{ media?: {src: String, alt?: String}, title?: String, content?: String (trusted HTML) }>
              — one carousel-item per entry; omit and use {% block slides %} to author items by hand
  - orientation?: 'horizontal'|'vertical' as string (default: 'horizontal')
  - loop?: Boolean (default: false) — embla `loop` option
  - align?: 'start'|'center'|'end' as string (default: 'start') — embla `align` option
  - showArrows?: Boolean (default: true)
  - showDots?: Boolean (default: false) — project-owned pager, not an upstream slot
  - contentClass?: String — extra classes on the flex track (upstream CarouselContent's
                            own `className`; a vertical carousel needs its height here)
  - slideClass?: String — extra classes on every carousel-item (e.g. 'md:basis-1/2')
  - ariaLabel?: String — label for the root region (strongly recommended)
  - labelPrev?: String (default: 'Slide precedente') — aria-label of the previous button
  - labelNext?: String (default: 'Slide successiva') — aria-label of the next button
  - id?: String
  - class?: String — appended last on the root; additive utilities only
  - attrs?: String — raw extra attributes on the root, trusted input only
  - blocks: slides — rendered when `slides` is not provided

  JS module (data-module="carousel.module"):
    consumes  CustomEvent 'carousel:prev' / 'carousel:next' / 'carousel:goto' ({ index }) on the root
    emits     CustomEvent 'carousel:change' ({ index, count }, bubbles: true) on the root
    hooks     data-orientation / data-loop / data-align on the root → embla options;
              [data-carousel-prev], [data-carousel-next], [data-carousel-dot][data-index]

  Port notes: the carousel-previous / carousel-next data-slots are restored via
  button.twig's slot param. `carousel-dots` is project-owned (no upstream
  equivalent): it reports as EXTRA in the gate, by design.
#}
{# `loop` is only Twig's loop object inside {% for %}; read the prop before the first loop. #}
{% set carousel_loop = loop is defined and loop ? 'true' : 'false' %}
{% set orientation = orientation|default('horizontal') %}
{% set showArrows = showArrows is defined ? showArrows : true %}
{% set showDots = showDots is defined ? showDots : false %}
{% set carousel_content = "flex" %}
{% set carousel_content_orientation = { horizontal: "-ml-4", vertical: "-mt-4 flex-col" } %}
{% set carousel_item = "min-w-0 shrink-0 grow-0 basis-full" %}
{% set carousel_item_orientation = { horizontal: "pl-4", vertical: "pt-4" } %}
{% set carousel_nav = "absolute size-8 rounded-full" %}
{% set carousel_previous_orientation = { horizontal: "top-1/2 -left-12 -translate-y-1/2", vertical: "-top-12 left-1/2 -translate-x-1/2 rotate-90" } %}
{% set carousel_next_orientation = { horizontal: "top-1/2 -right-12 -translate-y-1/2", vertical: "-bottom-12 left-1/2 -translate-x-1/2 rotate-90" } %}

<div data-slot="carousel" data-module="carousel.module"
  role="region" aria-roledescription="carousel"
  {%- if ariaLabel %} aria-label="{{ ariaLabel }}"{% endif %}
  data-orientation="{{ orientation }}"
  data-loop="{{ carousel_loop }}"
  data-align="{{ align|default('start') }}"
  {%- if id is defined and id %} id="{{ id }}"{% endif %}
  class="relative{% if class is defined and class %} {{ class }}{% endif %}" {{ attrs|default('')|raw }}>

  <div data-slot="carousel-content" class="overflow-hidden">
    <div class="{{ carousel_content }} {{ carousel_content_orientation[orientation] }}{% if contentClass is defined and contentClass %} {{ contentClass }}{% endif %}">
      {% if slides is defined and slides is not empty %}
        {% for slide in slides %}
        <div data-slot="carousel-item" role="group" aria-roledescription="slide"
          aria-label="{{ loop.index }} di {{ slides|length }}"
          class="{{ carousel_item }} {{ carousel_item_orientation[orientation] }}{% if slideClass is defined and slideClass %} {{ slideClass }}{% endif %}">
          {% if slide.media is defined and slide.media %}
            <img src="{{ slide.media.src }}" alt="{{ slide.media.alt|default('') }}" class="w-full rounded-lg object-cover">
          {% endif %}
          {% if slide.title is defined and slide.title %}
            <p class="mt-2 text-sm font-medium">{{ slide.title }}</p>
          {% endif %}
          {% if slide.content is defined and slide.content %}
            <div>{{ slide.content|raw }}</div>
          {% endif %}
        </div>
        {% endfor %}
      {% else %}
        {% block slides %}{% endblock %}
      {% endif %}
    </div>
  </div>

  {% if showArrows %}
    {% include '@components/base/button/button.twig' with {
      variant: 'outline',
      size: 'icon',
      icon: 'arrow-left',
      ariaLabel: labelPrev|default('Slide precedente'),
      slot: 'carousel-previous',
      class: carousel_nav ~ ' ' ~ carousel_previous_orientation[orientation],
      attrs: 'data-carousel-prev'
    } only %}
    {% include '@components/base/button/button.twig' with {
      variant: 'outline',
      size: 'icon',
      icon: 'arrow-right',
      ariaLabel: labelNext|default('Slide successiva'),
      slot: 'carousel-next',
      class: carousel_nav ~ ' ' ~ carousel_next_orientation[orientation],
      attrs: 'data-carousel-next'
    } only %}
  {% endif %}

  {% if showDots and slides is defined and slides is not empty %}
  <div data-slot="carousel-dots" role="group" aria-label="Scegli una slide" class="mt-4 flex justify-center gap-2">
    {% for slide in slides %}
    <button type="button" data-carousel-dot data-index="{{ loop.index0 }}"
      aria-label="Vai alla slide {{ loop.index }}"
      class="size-2 rounded-full bg-border transition-colors data-[active]:bg-primary"></button>
    {% endfor %}
  </div>
  {% endif %}
</div>
