{#
  Params:
  - label?: String — visible text; omit for icon-only sizes and provide ariaLabel instead
  - variant?: 'default'|'destructive'|'outline'|'secondary'|'ghost'|'link' as string (default: 'default')
  - size?: 'default'|'xs'|'sm'|'lg'|'icon'|'icon-xs'|'icon-sm'|'icon-lg' as string (default: 'default')
  - url?: String — when set renders <a> instead of <button>
  - target?: '_self'|'_blank' as string
  - type?: 'button'|'submit'|'reset' as string (default: 'button')
  - disabled?: Boolean
  - icon?: String — sprite icon name rendered before the label
  - iconAfter?: String — sprite icon name rendered after the label
  - ariaLabel?: String — REQUIRED when no label (icon-only sizes)
  - slot?: String — data-slot value (default: 'button'); override when this include fills
            another component's named part (e.g. 'dialog-trigger', 'pagination-previous')
  - labelClass?: String — extra classes on the label <span>, additive (e.g. upstream
            pagination's responsive 'hidden sm:block')
  - id?: String
  - class?: String — appended last; additive utilities only
  - attrs?: String — raw extra attributes, trusted input only
#}
{% set button_base = "inline-flex shrink-0 items-center justify-center gap-1.5 rounded-4xl text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4" %}
{% set button_variants = {
  default: "bg-primary text-primary-foreground hover:bg-primary/90",
  destructive: "bg-destructive text-white hover:bg-destructive/90 focus-visible:ring-destructive/20 dark:bg-destructive/60 dark:focus-visible:ring-destructive/40",
  outline: "border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50",
  secondary: "bg-secondary text-secondary-foreground hover:bg-secondary/80",
  ghost: "hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50",
  link: "text-primary underline-offset-4 hover:underline"
} %}
{% set button_sizes = {
  default: "h-9 px-3 py-2 has-[>svg]:px-3",
  xs: "h-6 gap-1 rounded-4xl px-2 text-xs has-[>svg]:px-1.5 [&_svg:not([class*='size-'])]:size-3",
  sm: "h-8 gap-1 rounded-4xl px-3 text-xs has-[>svg]:px-2.5",
  lg: "h-10 rounded-4xl px-6 has-[>svg]:px-4",
  icon: "size-9",
  'icon-xs': "size-6 rounded-4xl [&_svg:not([class*='size-'])]:size-3",
  'icon-sm': "size-8",
  'icon-lg': "size-10"
} %}
{% set variant = variant|default('default') %}
{% set size = size|default('default') %}
{% set button_classes = button_base ~ ' ' ~ button_variants[variant] ~ ' ' ~ button_sizes[size] ~ (class is defined and class ? ' ' ~ class : '') %}
{% if url %}
<a
  data-slot="{{ slot|default('button') }}"
  data-variant="{{ variant }}"
  data-size="{{ size }}"
  href="{{ url }}"
  class="{{ button_classes }}{% if disabled %} pointer-events-none opacity-50{% endif %}"
  {%- if target %} target="{{ target }}"{% if target == '_blank' %} rel="noopener noreferrer"{% endif %}{% endif %}
  {%- if ariaLabel %} aria-label="{{ ariaLabel }}"{% endif %}
  {%- if disabled %} aria-disabled="true"{% endif %}
  {%- if id is defined and id %} id="{{ id }}"{% endif %} {{ attrs|default('')|raw }}>
{% else %}
<button
  data-slot="{{ slot|default('button') }}"
  data-variant="{{ variant }}"
  data-size="{{ size }}"
  type="{{ type|default('button') }}"
  class="{{ button_classes }}"
  {%- if ariaLabel %} aria-label="{{ ariaLabel }}"{% endif %}
  {%- if disabled %} disabled{% endif %}
  {%- if id is defined and id %} id="{{ id }}"{% endif %} {{ attrs|default('')|raw }}>
{% endif %}
  {%- if icon %}<svg aria-hidden="true"><use href="#icon-{{ icon }}"></use></svg>{% endif %}
  {%- if label %}<span{% if labelClass %} class="{{ labelClass }}"{% endif %}>{{ label }}</span>{% endif %}
  {%- if iconAfter %}<svg aria-hidden="true"><use href="#icon-{{ iconAfter }}"></use></svg>{% endif %}
{% if url %}</a>{% else %}</button>{% endif %}
