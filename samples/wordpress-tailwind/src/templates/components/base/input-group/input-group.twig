{#
  Params:
  - input?: Object — props for the default control, rendered as base/input/input.twig's
              markup merged with InputGroupInput's upstream overrides (ignored when `textarea`
              is set or block control is overridden):
              { type?, name?, id?, value?, placeholder?, disabled?, required?, invalid?,
                ariaLabel?, attrs? }
  - textarea?: Object — same idea for a <textarea> control (InputGroupTextarea overrides):
              { name?, id?, value?, placeholder?, rows?, disabled?, required?, invalid?,
                ariaLabel?, attrs? }
  - addonStart?: { text?: String, icon?: String, align?: 'inline-start'|'block-start' as string
              (default: 'inline-start'),
              button?: { label?, icon?, ariaLabel?, disabled?, size?: 'xs'|'sm'|'icon-xs'|'icon-sm'
                as string (default: 'icon-xs') } — a ghost icon button, input-group's own size
                scale (inputGroupButtonVariants), not base/button's }
  - addonEnd?: { text?: String, icon?: String, align?: 'inline-end'|'block-end' as string
              (default: 'inline-end'), button?: Object — see addonStart.button }
  - id?: String
  - class?: String — appended last on the input-group root; additive utilities only
  - attrs?: String — raw extra attributes on the input-group root, trusted input only
  - blocks: addon_start, control, addon_end — override via {% embed %} for custom markup;
              `input_group_addon_base`, `input_group_addon_aligns` and `input_group_text_classes`
              are in scope inside overridden blocks

  Figma override (scripts/upstream-exceptions.json "input-group"): the container's own corner
  radius is 26px (pill, matching base/button's rounded-4xl), not upstream's rounded-md — height
  (36px) and the container's own padding/gap already match upstream, so only the radius token is
  replaced. A textarea-in-group measures 18px (rounded-2xl, matching base/textarea) instead: since
  the base string can't express two radii, the 18px case is added as an extra `has-[>textarea]`
  utility rather than a second exception (same convention as item's px-4/py-3.5 split).

  The inner control classes below hand-merge upstream Input/Textarea's own base string with
  InputGroupInput/InputGroupTextarea's override string (tailwind-merge is not available in Twig):
  border, bg, shadow and ring utilities from the plain control are dropped in favor of the
  input-group override that replaces them (rounded-none border-0 bg-transparent shadow-none
  focus-visible:ring-0), matching what @tailwind-merge computes for the upstream React output.
#}
{% set input = input|default(null) %}
{% set textarea = textarea|default(null) %}
{% set input_group_addon_base = "flex h-auto cursor-text items-center justify-center gap-2 py-1.5 text-sm font-medium text-muted-foreground select-none group-data-[disabled=true]/input-group:opacity-50 [&>kbd]:rounded-[calc(var(--radius)-5px)] [&>svg:not([class*='size-'])]:size-4" %}
{% set input_group_addon_aligns = {
  'inline-start': "order-first pl-3 has-[>button]:ml-[-0.45rem] has-[>kbd]:ml-[-0.35rem]",
  'inline-end': "order-last pr-3 has-[>button]:mr-[-0.45rem] has-[>kbd]:mr-[-0.35rem]",
  'block-start': "order-first w-full justify-start px-3 pt-3 group-has-[>input]/input-group:pt-2.5 [.border-b]:pb-3",
  'block-end': "order-last w-full justify-start px-3 pb-3 group-has-[>input]/input-group:pb-2.5 [.border-t]:pt-3"
} %}
{% set input_group_text_classes = "flex items-center gap-2 text-sm text-muted-foreground [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4" %}
{# InputGroupButton = <Button variant="ghost" className={cn(inputGroupButtonVariants({size}), className)}>:
   the ghost Button base is hand-merged with inputGroupButtonVariants's own base/size overrides
   (flex replaces inline-flex, gap-2 replaces gap-1.5, shadow-none added — tailwind-merge applied
   by hand, no runtime merge in Twig); the four size maps are all written out literally below so
   every inputGroupButtonVariants token is present regardless of which size a given button uses. #}
{% set input_group_button_base = "flex shrink-0 items-center justify-center gap-2 rounded-4xl text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 shadow-none" %}
{% set input_group_button_sizes = {
  xs: "h-6 gap-1 rounded-[calc(var(--radius)-5px)] px-2 has-[>svg]:px-2 [&>svg:not([class*='size-'])]:size-3.5",
  sm: "h-8 gap-1.5 rounded-md px-2.5 has-[>svg]:px-2.5",
  'icon-xs': "size-6 rounded-[calc(var(--radius)-5px)] p-0 has-[>svg]:p-0",
  'icon-sm': "size-8 p-0 has-[>svg]:p-0"
} %}
{% macro inputGroupButton(btn, base, sizes) %}
  {%- set size = btn.size|default('icon-xs') %}
  <button type="button" data-slot="button" data-size="{{ size }}" class="{{ base }} {{ sizes[size] }}"
    {%- if btn.disabled %} disabled{% endif %}
    {%- if btn.ariaLabel %} aria-label="{{ btn.ariaLabel }}"{% endif %}>
    {%- if btn.icon %}<svg aria-hidden="true"><use href="#icon-{{ btn.icon }}"></use></svg>{% endif %}
    {%- if btn.label %}<span>{{ btn.label }}</span>{% endif %}
  </button>
{% endmacro %}
{% import _self as self %}
{% set input_group_classes = "group/input-group relative flex w-full items-center rounded-4xl border border-input shadow-xs transition-[color,box-shadow] outline-none dark:bg-input/30 has-[>textarea]:rounded-2xl h-9 min-w-0 has-[>textarea]:h-auto has-[>[data-align=inline-start]]:[&>input]:pl-2 has-[>[data-align=inline-end]]:[&>input]:pr-2 has-[>[data-align=block-start]]:h-auto has-[>[data-align=block-start]]:flex-col has-[>[data-align=block-start]]:[&>input]:pb-3 has-[>[data-align=block-end]]:h-auto has-[>[data-align=block-end]]:flex-col has-[>[data-align=block-end]]:[&>input]:pt-3 has-[[data-slot=input-group-control]:focus-visible]:border-ring has-[[data-slot=input-group-control]:focus-visible]:ring-[3px] has-[[data-slot=input-group-control]:focus-visible]:ring-ring/50 has-[[data-slot][aria-invalid=true]]:border-destructive has-[[data-slot][aria-invalid=true]]:ring-destructive/20 dark:has-[[data-slot][aria-invalid=true]]:ring-destructive/40" ~ (class is defined and class ? ' ' ~ class : '') %}
{% set input_group_control_classes = "h-9 w-full min-w-0 border-input px-3 py-1 text-base transition-[color,box-shadow] outline-none selection:bg-primary selection:text-primary-foreground file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm focus-visible:border-ring aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 flex-1 rounded-none border-0 bg-transparent shadow-none focus-visible:ring-0 dark:bg-transparent" %}
{% set input_group_textarea_classes = "field-sizing-content flex min-h-16 w-full border-input px-3 py-3 text-base transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/30 dark:aria-invalid:ring-destructive/40 flex-1 resize-none rounded-none border-0 bg-transparent shadow-none focus-visible:ring-0 dark:bg-transparent" %}
<div data-slot="input-group" role="group" class="{{ input_group_classes }}"
  {%- if id is defined and id %} id="{{ id }}"{% endif %}
  {%- if (input and input.disabled) or (textarea and textarea.disabled) %} data-disabled="true"{% endif %} {{ attrs|default('')|raw }}>

  {% block addon_start %}
    {%- if addonStart %}
    {%- set align = addonStart.align|default('inline-start') %}
    <div role="group" data-slot="input-group-addon" data-align="{{ align }}" class="{{ input_group_addon_base }} {{ input_group_addon_aligns[align] }}">
      {%- if addonStart.icon %}<svg aria-hidden="true"><use href="#icon-{{ addonStart.icon }}"></use></svg>{% endif %}
      {%- if addonStart.text %}<span class="{{ input_group_text_classes }}">{{ addonStart.text }}</span>{% endif %}
      {%- if addonStart.button %}{{ self.inputGroupButton(addonStart.button, input_group_button_base, input_group_button_sizes) }}{% endif %}
    </div>
    {%- endif %}
  {% endblock %}

  {% block control %}
    {%- if textarea %}
    <textarea data-slot="input-group-control" class="{{ input_group_textarea_classes }}"
      {%- if textarea.name %} name="{{ textarea.name }}"{% endif %}
      {%- if textarea.id %} id="{{ textarea.id }}"{% endif %}
      {%- if textarea.placeholder %} placeholder="{{ textarea.placeholder }}"{% endif %}
      {%- if textarea.rows %} rows="{{ textarea.rows }}"{% endif %}
      {%- if textarea.disabled %} disabled{% endif %}
      {%- if textarea.required %} required{% endif %}
      {%- if textarea.invalid %} aria-invalid="true"{% endif %}
      {%- if textarea.ariaLabel %} aria-label="{{ textarea.ariaLabel }}"{% endif %} {{ textarea.attrs|default('')|raw }}>{%- if textarea.value %}{{ textarea.value }}{% endif %}</textarea>
    {%- elseif input %}
    <input data-slot="input-group-control" type="{{ input.type|default('text') }}" class="{{ input_group_control_classes }}"
      {%- if input.name %} name="{{ input.name }}"{% endif %}
      {%- if input.id %} id="{{ input.id }}"{% endif %}
      {%- if input.value is defined %} value="{{ input.value }}"{% endif %}
      {%- if input.placeholder %} placeholder="{{ input.placeholder }}"{% endif %}
      {%- if input.disabled %} disabled{% endif %}
      {%- if input.required %} required{% endif %}
      {%- if input.invalid %} aria-invalid="true"{% endif %}
      {%- if input.ariaLabel %} aria-label="{{ input.ariaLabel }}"{% endif %} {{ input.attrs|default('')|raw }}>
    {%- endif %}
  {% endblock %}

  {% block addon_end %}
    {%- if addonEnd %}
    {%- set align = addonEnd.align|default('inline-end') %}
    <div role="group" data-slot="input-group-addon" data-align="{{ align }}" class="{{ input_group_addon_base }} {{ input_group_addon_aligns[align] }}">
      {%- if addonEnd.icon %}<svg aria-hidden="true"><use href="#icon-{{ addonEnd.icon }}"></use></svg>{% endif %}
      {%- if addonEnd.text %}<span class="{{ input_group_text_classes }}">{{ addonEnd.text }}</span>{% endif %}
      {%- if addonEnd.button %}{{ self.inputGroupButton(addonEnd.button, input_group_button_base, input_group_button_sizes) }}{% endif %}
    </div>
    {%- endif %}
  {% endblock %}

</div>
