{#
  Params:
  - title?: String — heading in popover-header (wired to aria-labelledby by the module)
  - text?: String — body paragraph in popover-header (aria-describedby)
  - triggerLabel?: String — renders a default outline button trigger; override via block trigger
                            (custom triggers must carry data-popover-trigger)
  - side?: 'top'|'right'|'bottom'|'left' as string (default: 'bottom')
  - align?: 'start'|'center'|'end' as string (default: 'center')
  - sideOffset?: Number — distance trigger→panel in px (default: 4)
  - id?: String — id of popover-content (aria-controls target); generated by the module when omitted
  - class?: String — extra classes on popover-content; additive only
  - attrs?: String — raw extra attributes on the popover-content, trusted input only
  - blocks: trigger, content
  - close hook: any element with [data-popover-close] inside the panel closes it

  JS module (data-module="popover.module"):
    consumes  click on [data-popover-trigger] toggles the panel
    emits     (module manages aria-expanded/aria-controls only; see PORTING.md
              Integration API for the generic pattern — popover has no
              open/close events of its own, unlike dialog/tooltip)
    hooks     data-side / data-align / data-side-offset on the root → positioning

  Adaptation: `origin-(--radix-popover-content-transform-origin)` →
  `origin-(--transform-origin)`, written by common/floating.js (PORTING.md
  Adaptation table).
#}

<div data-slot="popover" data-module="popover.module" class="inline-block"
  data-side="{{ side|default('bottom') }}" data-align="{{ align|default('center') }}" data-side-offset="{{ sideOffset|default(4) }}">

  {% block trigger %}
    {% if triggerLabel %}
      {% include '@components/base/button/button.twig' with {
        label: triggerLabel,
        variant: 'outline',
        attrs: 'data-popover-trigger aria-haspopup="dialog" aria-expanded="false"'
      } only %}
    {% endif %}
  {% endblock %}

  <div data-slot="popover-content" role="dialog" tabindex="-1" hidden data-state="closed"
    {%- if id %} id="{{ id }}"{% endif %}
    class="z-50 w-72 origin-(--transform-origin) rounded-md border bg-popover p-4 text-popover-foreground shadow-md outline-hidden data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95{% if class is defined and class %} {{ class }}{% endif %}"
    {{ attrs|default('')|raw }}>
    {% block content %}
      {% if title or text %}
      <div data-slot="popover-header" class="flex flex-col gap-1 text-sm">
        {% if title %}<h4 data-slot="popover-title" class="font-medium">{{ title }}</h4>{% endif %}
        {% if text %}<p data-slot="popover-description" class="text-muted-foreground">{{ text }}</p>{% endif %}
      </div>
      {% endif %}
    {% endblock %}
  </div>
</div>
