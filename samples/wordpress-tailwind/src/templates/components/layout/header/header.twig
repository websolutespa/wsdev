{#
  Site header: sticky bar, desktop base/navigation-menu, theme toggle and a mobile
  base/sheet (side left) reusing the same menu data. No params — reads layout.site,
  layout.menu and layout.header.cta from globals (main.json), plus labels['theme.toggle']
  and labels['menu.open'].

  The mobile trigger button opens the sheet declaratively via [data-dialog-open="mobile-menu"]
  (dialog.module, reused by sheet) instead of the sheet's own default trigger block, so the
  button can be icon-only and sit next to the theme toggle.
#}
{% set header_cta = layout.header.cta|default(null) %}

<header data-slot="site-header" class="sticky top-0 z-40 w-full border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href="%BASE_URL%" class="shrink-0 font-serif text-lg font-medium text-foreground">{{ layout.site.name }}</a>

    <div class="hidden lg:block">
      {% include '@components/layout/main-menu/main-menu.twig' with { variant: 'desktop' } only %}
    </div>

    <div class="flex items-center gap-2">
      <button type="button" data-toggle="color-scheme" aria-label="{{ labels['theme.toggle'] }}"
        class="inline-flex size-9 shrink-0 items-center justify-center rounded-md border border-border text-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
        <svg aria-hidden="true" class="dark:hidden"><use href="#icon-sun"></use></svg>
        <svg aria-hidden="true" class="hidden dark:block"><use href="#icon-moon"></use></svg>
      </button>

      {% if header_cta %}
      <div class="hidden sm:block">
        {% include '@components/base/button/button.twig' with { label: header_cta.label, url: header_cta.url, size: 'sm' } only %}
      </div>
      {% endif %}

      <div class="lg:hidden">
        {% include '@components/base/button/button.twig' with { ariaLabel: labels['menu.open'], icon: 'menu', variant: 'outline', size: 'icon', attrs: 'data-dialog-open="mobile-menu"' } only %}
      </div>
    </div>
  </div>

  {% embed '@components/base/sheet/sheet.twig' with { id: 'mobile-menu', side: 'left', title: layout.site.name } only %}
    {% block body %}
    <div class="flex flex-col gap-6 overflow-y-auto p-4">
      {% include '@components/layout/main-menu/main-menu.twig' with { variant: 'mobile' } only %}
      {% if header_cta %}
      {% include '@components/base/button/button.twig' with { label: header_cta.label, url: header_cta.url, class: 'w-full' } only %}
      {% endif %}
    </div>
    {% endblock %}
  {% endembed %}
</header>
