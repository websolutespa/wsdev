{#
  Params:
  - eyebrow?: String — badge text rendered above the title
  - title: String — heading text (required)
  - heading?: 'h1'|'h2' as string (default: 'h1') — h1 on the homepage hero, h2 when reused
              lower on a page
  - abstract?: String — supporting paragraph under the title
  - cta?: { label: String, url: String, variant?: String (default: 'default') } — primary action
  - navs?: Array<{ label: String, url: String, variant?: String (default: 'outline') }> —
            secondary actions rendered next to cta; data-driven, never embeds inside a loop
  - media?: { src: String, alt?: String } — optional illustration. This sample has not ported a
            media/image component (not a shadcn base component), so it renders a plain <img> per
            PORTING.md's documented fallback
  - id?: String
  - class?: String — appended last on the section root; additive utilities only
  - attrs?: String — raw extra attributes on the section root, trusted input only
#}
{% set heading_tag = heading|default('h1') == 'h2' ? 'h2' : 'h1' %}

<section data-slot="hero"
  class="py-ws-6xl{% if class is defined and class %} {{ class }}{% endif %}"
  {%- if id is defined and id %} id="{{ id }}"{% endif %} {{ attrs|default('')|raw }}>
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4{% if media %} lg:grid-cols-2{% endif %}">
    <div class="flex flex-col items-start gap-6{% if not media %} mx-auto max-w-3xl items-center text-center{% endif %}">
      {% if eyebrow %}
      {% include '@components/base/badge/badge.twig' with { label: eyebrow, variant: 'secondary' } only %}
      {% endif %}
      <{{ heading_tag }} class="text-balance text-5xl font-serif text-foreground">{{ title }}</{{ heading_tag }}>
      {% if abstract %}<p class="text-balance text-lg text-muted-foreground">{{ abstract }}</p>{% endif %}
      {% if cta or navs %}
      <div class="flex flex-wrap items-center gap-3{% if not media %} justify-center{% endif %}">
        {% if cta %}
        {% include '@components/base/button/button.twig' with { label: cta.label, url: cta.url, variant: cta.variant|default('default'), size: 'lg' } only %}
        {% endif %}
        {% for nav in navs|default([]) %}
        {% include '@components/base/button/button.twig' with { label: nav.label, url: nav.url, variant: nav.variant|default('outline'), size: 'lg' } only %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% if media %}
    <div class="overflow-hidden rounded-2xl border border-border">
      <img src="{{ media.src }}" alt="{{ media.alt|default('') }}" class="h-full w-full object-cover" loading="eager">
    </div>
    {% endif %}
  </div>
</section>
