{% extends 'layouts/layout.twig' %}

{% block main %}
<main id="main" class="mx-auto max-w-6xl px-4 py-16">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border pb-6">
    <div>
      <p class="text-sm text-muted-foreground"><a href="/docs/components.html" class="hover:underline">← Tutti i componenti</a></p>
      <h1 class="text-4xl font-serif">{{ page.title }}</h1>
      <p class="mt-2 text-muted-foreground">{{ page.abstract }}</p>
    </div>
    <button type="button" data-toggle="color-scheme" class="rounded-md border border-border px-3 py-1.5 text-sm">
      <span class="dark:hidden">☀︎ Chiaro</span>
      <span class="hidden dark:inline">☾ Scuro</span>
    </button>
  </div>

  {% set current_group = null %}
  {% for g in docs.groups %}
    {% if g.id == group %}{% set current_group = g %}{% endif %}
  {% endfor %}
  {% if current_group %}
    {% include 'partials/docs/component-section.twig' with { group: current_group, mocks: mocks } only %}
  {% endif %}
</main>
{% endblock %}
