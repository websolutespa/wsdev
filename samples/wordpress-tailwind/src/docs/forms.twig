{% extends 'layouts/layout.twig' %}

{% block main %}
<main id="main" class="mx-auto max-w-3xl px-4 py-16">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border pb-6">
    <div>
      <h1 class="text-4xl font-serif">Form</h1>
      <p class="mt-2 text-muted-foreground">Composizione di base/field con la validazione via form.module.js, e un esempio di form Formidable con l'adapter CSS.</p>
    </div>
    <button type="button" data-toggle="color-scheme" class="rounded-md border border-border px-3 py-1.5 text-sm">
      <span class="dark:hidden">☀︎ Chiaro</span>
      <span class="hidden dark:inline">☾ Scuro</span>
    </button>
  </div>

  <section class="mt-12">
    <h2 class="text-2xl font-serif">Form nativo (base/field + form.module.js)</h2>
    <p class="mt-2 text-sm text-muted-foreground">
      Validazione al blur e al submit, honeypot anti-spam, invio via <code>fetch</code>
      (<code>data-submit="fetch"</code>) con eventi <code>form:invalid</code>, <code>form:submitted</code>,
      <code>form:error</code>. Apri la console per vederli.
    </p>

    <form
      data-module="form.module"
      data-submit="fetch"
      action="/docs/forms.html"
      method="post"
      class="mt-6 flex flex-col gap-6 rounded-xl border bg-card p-6">

      {% embed '@components/base/field/field.twig' with { label: 'Nome completo', for: 'forms-demo-nome', description: "Come indicato sul documento d'identità." } only %}
        {% block control %}
          {% include '@components/base/input/input.twig' with { id: 'forms-demo-nome', name: 'nome', required: true, placeholder: 'Mario Rossi' } only %}
        {% endblock %}
      {% endembed %}

      {% embed '@components/base/field/field.twig' with { label: 'Email', for: 'forms-demo-email' } only %}
        {% block control %}
          {% include '@components/base/input/input.twig' with {
            id: 'forms-demo-email', name: 'email', type: 'email', required: true, placeholder: 'nome@azienda.it',
            attrs: 'data-error-value-missing="Inserisci un indirizzo email." data-error-type-mismatch="Il formato dell\'email non è valido."'
          } only %}
        {% endblock %}
      {% endembed %}

      {% embed '@components/base/field/field.twig' with { label: 'Priorità richiesta', for: 'forms-demo-priorita' } only %}
        {% block control %}
          {% include '@components/base/native-select/native-select.twig' with { id: 'forms-demo-priorita', name: 'priorita', options: [
            { value: 'bassa', label: 'Bassa' },
            { value: 'media', label: 'Media', selected: true },
            { value: 'alta', label: 'Alta' }
          ] } only %}
        {% endblock %}
      {% endembed %}

      {% embed '@components/base/field/field.twig' with { label: 'Messaggio', for: 'forms-demo-messaggio' } only %}
        {% block control %}
          {% include '@components/base/textarea/textarea.twig' with { id: 'forms-demo-messaggio', name: 'messaggio', required: true, rows: 4, placeholder: 'Descrivi la richiesta…' } only %}
        {% endblock %}
      {% endembed %}

      {# Honeypot — hidden from real users via layout, left filled only by bots; form.module.js
         silently drops the submission if this has a value. #}
      <div class="hidden" aria-hidden="true">
        <label for="forms-demo-website">Non compilare questo campo</label>
        <input type="text" id="forms-demo-website" name="website" data-honeypot tabindex="-1" autocomplete="off">
      </div>

      <div class="flex justify-end">
        {% include '@components/base/button/button.twig' with { type: 'submit', label: 'Invia richiesta' } only %}
      </div>
    </form>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-serif">Form Formidable (src/css/adapters/formidable.css)</h2>
    <p class="mt-2 text-sm text-muted-foreground">
      Markup statico con le classi reali generate da Formidable Forms (<code>frm_forms</code>,
      <code>frm_form_field</code>, <code>frm_primary_label</code>…). Per vedere questa sezione
      stilizzata come i componenti sopra, decommenta
      <code>@import './adapters/formidable.css';</code> in <code>src/css/globals.css</code> —
      resta commentato di default perché l'adapter va abilitato solo sui siti/pagine che
      renderizzano davvero form Formidable.
    </p>

    <div class="frm_forms mt-6 rounded-xl border bg-card p-6">
      <fieldset>
        <div class="frm_form_field form-field">
          <label class="frm_primary_label" for="frm_field_nome">
            Nome e cognome
            <span class="frm_required">*</span>
          </label>
          <input type="text" id="frm_field_nome" name="item_meta[100]" required>
          <div class="frm_description">Come indicato sul documento d'identità.</div>
        </div>

        <div class="frm_form_field form-field frm_error_style">
          <label class="frm_primary_label" for="frm_field_email">Email</label>
          <input type="email" id="frm_field_email" name="item_meta[101]" required aria-invalid="true">
          <div class="frm_error">Il formato dell'email non è valido.</div>
        </div>

        <div class="frm_submit">
          <button type="submit">Invia</button>
        </div>
      </fieldset>
    </div>
  </section>
</main>
{% endblock %}
