{% extends 'layouts/layout.twig' %}

{% block main %}
<main id="main" class="mx-auto max-w-6xl px-4 py-16">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border pb-6">
    <div>
      <h1 class="text-4xl font-serif">Componenti</h1>
      <p class="mt-2 text-muted-foreground">Showcase dei componenti shadcn/ui portati in Twig, in chiaro e in scuro — una pagina per gruppo.</p>
    </div>
    <button type="button" data-toggle="color-scheme" class="rounded-md border border-border px-3 py-1.5 text-sm">
      <span class="dark:hidden">☀︎ Chiaro</span>
      <span class="hidden dark:inline">☾ Scuro</span>
    </button>
  </div>

  <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {% for group in docs.groups %}
    <li>
      <a href="/docs/components/{{ group.id }}.html" class="block h-full rounded-xl border bg-card p-6 transition-colors hover:bg-accent hover:text-accent-foreground">
        <h2 class="text-lg font-medium">{{ group.title }}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{{ group.components|length }} component{{ group.components|length == 1 ? 'e' : 'i' }}</p>
      </a>
    </li>
    {% endfor %}
    <li>
      <a href="/docs/forms.html" class="block h-full rounded-xl border bg-card p-6 transition-colors hover:bg-accent hover:text-accent-foreground">
        <h2 class="text-lg font-medium">Form</h2>
        <p class="mt-1 text-sm text-muted-foreground">Composizione base/field + validazione, adapter Formidable</p>
      </a>
    </li>
  </ul>
</main>
{% endblock %}
