{% extends 'layouts/layout.twig' %}

{% block main %}
<main id="main" class="mx-auto max-w-6xl px-4 py-16">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border pb-6">
    <div>
      <p class="text-sm text-muted-foreground"><a href="/docs/components.html" class="hover:underline">← Componenti</a></p>
      <h1 class="text-4xl font-serif">{{ page.title }}</h1>
      <p class="mt-2 text-muted-foreground">{{ page.abstract }}</p>
    </div>
    <button type="button" data-toggle="color-scheme" class="rounded-md border border-border px-3 py-1.5 text-sm">
      <span class="dark:hidden">☀︎ Chiaro</span>
      <span class="hidden dark:inline">☾ Scuro</span>
    </button>
  </div>

  {% for block in blocks %}
  <section class="mt-12 border-b border-border pb-12 last:border-b-0 last:pb-0">
    <p class="font-mono text-xs uppercase tracking-wide text-muted-foreground">{{ block.schema }}</p>
    <div class="mt-4 overflow-hidden rounded-xl border border-border">
      {% include '@components/blocks/' ~ block.schema ~ '/' ~ block.schema ~ '.twig' with block.mock only %}
    </div>
  </section>
  {% endfor %}
</main>
{% endblock %}
